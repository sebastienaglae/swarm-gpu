{
  "name": "swarm-gpu",
  "version": "1.0.0",
  "private": true,
  "description": "A raw WebGPU renderer for GPU-simulated, culled, LOD-classified, indirect-drawn swarms.",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark:smoke": "node scripts/benchmark-phase-06.mjs http://127.0.0.1:5174/",
    "benchmark:compare": "node scripts/compare-phase-06.mjs",
    "benchmark:budgets": "node scripts/check-phase-06-budgets.mjs",
    "stress:quick": "node scripts/run-phase-07.mjs quick",
    "stress:full": "node scripts/run-phase-07.mjs full",
    "stress:reports": "node scripts/check-phase-07-reports.mjs",
    "test:visual": "node scripts/visual-regression-phase-07.mjs",
    "capture:release": "npm run build && node scripts/capture-phase-08.mjs",
    "check:links": "node scripts/check-links.mjs",
    "audit:release": "node scripts/release-audit.mjs",
    "smoke:production": "npm run build && node scripts/smoke-production.mjs",
    "smoke:hosted": "node scripts/smoke-hosted.mjs",
    "release:check": "npm run check && npm run test:e2e && npm run benchmark:budgets && npm run stress:reports && npm run check:links && npm run audit:release",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@webgpu/types": "0.1.72",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
